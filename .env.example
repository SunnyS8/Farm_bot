# По умолчанию НЕТ внешних вызовов. Не вставляйте реальные значения в чат.
RUN_MODE=offline
PORT=8787
# Папка базы зафиксирована в коде; произвольный VAULT_PATH не поддерживается.
BITRIX_DOMAIN=crm.escom.group
BITRIX_MEMBER_ID=
BITRIX_APPLICATION_TOKEN=
BITRIX_BOT_ID=
# Новый входящий webhook с imbot. Старый со скриншота сначала отозвать.
BITRIX_WEBHOOK_URL=
# Тот же CLIENT_ID, с которым зарегистрирован legacy-бот.
BITRIX_CLIENT_ID=
# Отдельный ключ пользователя, НЕ ключи/токены OpenCode.
# Поддерживается только явно выбранный протокол OpenAI-compatible Chat Completions.
# Hubris: предварительный выбор, доступность/качество ещё не проверены.
# Base URL: https://api.hubris.pw/v1; адаптер требует ПОЛНЫЙ endpoint.
LLM_PROTOCOL=openai-chat-completions
LLM_PROVIDER=Hubris
LLM_ENDPOINT=https://api.hubris.pw/v1/chat/completions
LLM_MODEL=openai/gpt-4o-mini
# Явный бюджет ответа (включая reasoning у некоторых моделей), диапазон 256–8192.
# Платная модель выбрана с явного разрешения пользователя; текущая цена не проверена.
# Бюджет ограничен, автоматических повторов/fallback нет.
LLM_MAX_TOKENS=1400
# Раскрытый на скриншоте ключ отозвать; новый ввести ТОЛЬКО локально.
LLM_API_KEY=
# Автоматического fallback на другие (в том числе платные) модели нет.

# Telegram — отдельные учётные данные, Bitrix user IDs сюда НЕ копировать.
# Новый bot через официальный @BotFather /newbot; токен вводить только локально.
TELEGRAM_BOT_TOKEN=
# Явно запрошенный публичный Telegram-пилот: все люди, но ТОЛЬКО private-чаты.
# В коде при отсутствии переменной default=allowlist (пустой список запрещает всех).
TELEGRAM_ACCESS_MODE=public
# Дневных/per-user/session квот и программного рублёвого бюджета нет по запросу пользователя.
# Для TELEGRAM_ACCESS_MODE=allowlist: пусто = deny all. В public список не требуется.
# Только подтверждённые numeric Telegram from.id, через запятую.
TELEGRAM_ALLOWED_USER_IDS=
# RUN_MODE оставить offline; Telegram live включается отдельно CLI --live
# и явным согласием --allow-telegram-polling (не запускайте без разрешения).
